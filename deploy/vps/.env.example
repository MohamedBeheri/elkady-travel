# ==== ELKADY TRAVEL — production environment (VPS) ====
# Copy this file to  /opt/elkady/backend/.env  and fill in real values.
# Everything here is ISOLATED from the MPFC app (its own DB, user, socket, service).

DEBUG=False

# Generate a fresh one:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Hostnames that may serve this app (comma-separated, no spaces).
ALLOWED_HOSTS=elkady-travel.com,www.elkady-travel.com,31.97.118.178

# HTTPS origins (after certbot).
CSRF_TRUSTED_ORIGINS=https://elkady-travel.com,https://www.elkady-travel.com
CORS_ALLOWED_ORIGINS=https://elkady-travel.com,https://www.elkady-travel.com

# --- Dedicated PostgreSQL database (separate cluster role + db from MPFC) ---
DATABASE_URL=postgres://elkady_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/elkady_db
# ^ replace CHANGE_ME_DB_PASSWORD with the same password used in step 1 of DEPLOY_VPS.md
# Local Postgres on the same host has no SSL — keep this False.
DB_SSL=False

# Keep False while reaching the site over plain HTTP (IP:port or before TLS).
# Set True AFTER you install a TLS certificate (certbot) and serve on https.
SECURE_SSL_REDIRECT=False
